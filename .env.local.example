# Local machine configuration. The Docker bot uses the database service name `db`;
# the same file points a locally launched `uv run pythia` process at localhost.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_VISION_MODEL=
# Optional: leave empty to access only public data without Instagram login.
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_FILE=

DATABASE_URL=postgresql://pythia:pythia@localhost:5432/pythia
LOCAL_POSTGRES_DB=pythia
LOCAL_POSTGRES_USER=pythia
LOCAL_POSTGRES_PASSWORD=pythia
LOCAL_POSTGRES_PORT=5432

WORK_DIR=/tmp/pythia
FRAME_COUNT=8
MAX_CONCURRENT_ANALYSES=1

# Raspberry Pi + Supabase configuration. Copy this file to .env on the Pi.
# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Supabase PostgreSQL direct connection string. Standard postgres:// URLs are adapted to asyncpg automatically.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require

# OpenAI model identifiers are intentionally configuration, not code constants.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_VISION_MODEL=

WORK_DIR=/tmp/pythia
FRAME_COUNT=8
MAX_CONCURRENT_ANALYSES=1
